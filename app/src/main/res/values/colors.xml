<?xml version="1.0" encoding="utf-8"?>
<!--
  Native (non-Compose) colour resources. Everything Compose-side lives in
  ui/theme/Color.kt — these XML values are used only by the splash screen
  (which renders before Compose mounts) and any legacy XML layouts.
-->
<resources>
    <!-- Brand viridian — matches NitiColors.primary -->
    <color name="brand">#FF0F7F5E</color>
    <!-- Splash background — viridian so the transition into the in-app
         top bar is seamless (was incorrectly WhatsApp green #075E54). -->
    <color name="splash_bg">#FF0F7F5E</color>
</resources>
