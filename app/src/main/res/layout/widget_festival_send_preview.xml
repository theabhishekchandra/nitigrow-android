<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview approximating the Glance content (espresso card, turmeric pill). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_card_espresso"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_bg_glyph_turmeric"
            android:gravity="center"
            android:text="र"
            android:textColor="#FFF5D78C"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Festival greetings"
            android:textColor="#FFF5EFDF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="11dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Greet customers on upcoming festivals"
            android:textColor="#FFA89E87"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_bg_pill_turmeric"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Plan a send"
            android:textColor="#FF4A2F0A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
